# ---------- Build stage ----------
# Runs on the build host's native architecture and cross-compiles to the
# target, so arm64 images build at full speed on any host, with no emulation.
# Chainguard's Go image rather than Docker Hub's golang image; this stage
# never ships, so it only needs a Go toolchain (the image also has bash).
# Chainguard publishes only the `latest` tag for free, so the Go version
# floats; go.mod's `go` line is the minimum it must satisfy.
FROM --platform=$BUILDPLATFORM cgr.dev/chainguard/go:latest AS build
USER 0

# Set automatically by podman build.
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY *.go ./
RUN CGO_ENABLED=0 \
    GOOS=${TARGETOS:-$(go env GOOS)} \
    GOARCH=${TARGETARCH:-$(go env GOARCH)} \
    go build -trimpath -ldflags="-s -w" -o /out/broker .

# ---------- Runtime stage ----------
# Same rationale as the Controller: no shell, no libc, no package manager,
# nothing an attacker could use if this process were ever compromised.
# `scratch` is the empty image; nothing is pulled for it.
FROM scratch

# Links the GHCR package to its source repository.
LABEL org.opencontainers.image.source="https://github.com/danny-berg-whitt/fishcam-webcam-streamer-contoller-broker"
LABEL org.opencontainers.image.description="FishCam broker: bearer-token front end for the webcam controller"

COPY --from=build /out/broker /broker
USER 65534:65534
EXPOSE 8082
ENTRYPOINT ["/broker"]
