# Copy to deploy.env (git-ignored) and set for your cluster and host.
# make, k8s/render.sh and the app's build (--dart-define-from-file) all read
# it, so use plain KEY=value lines: no quotes, no spaces, and comments on
# their own lines (make keeps the space before an inline comment).

# Public hostname of the API. The app uses https://<host> unless WEBCAM_URL
# is set.
WEBCAM_HOST=webcam.example.com

# key=value label for the node the webcam is plugged into; the pod is pinned
# to it. `make label-node` applies it (NODE=<name> on a multi-node cluster).
WEBCAM_NODE_LABEL=webcam=attached

# Where images are pushed and pulled: <REGISTRY>/fishcam-<component>:<TAG>.
REGISTRY=ghcr.io/your-github-user
TAG=latest

# Optional app server address, e.g. http://localhost:8082 via port-forward.
# WEBCAM_URL=
