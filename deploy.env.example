# Settings for one deployment of the webcam service. Copy this file to
# deploy.env (git-ignored) and set the values for your cluster and host.
#
# Read by make, by k8s/render.sh, and by the Flutter app's build
# (flutter build ... --dart-define-from-file=../deploy.env), so keep to
# plain KEY=value lines: no quotes, no spaces, and comments only on lines
# of their own (make would keep the space before an inline comment).

# Public hostname the ingress serves the API on. The app connects to
# https://<this host> unless WEBCAM_URL is set.
WEBCAM_HOST=webcam.example.com

# Node label marking the node the webcam is plugged into, as key=value.
# The pod is pinned to that node by a nodeSelector; `make label-node` (run by
# `make deploy`) applies the label, to NODE=<node name> if given.
WEBCAM_NODE_LABEL=webcam=attached

# Registry the images are pushed to and the cluster pulls them from, and
# their tag. Images are named <REGISTRY>/fishcam-{streamer,controller,broker}.
REGISTRY=ghcr.io/your-github-user
TAG=latest

# Optional: the app's server address, when it isn't https://WEBCAM_HOST
# (for example http://localhost:8082 through `kubectl port-forward`).
# WEBCAM_URL=
