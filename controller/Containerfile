# ---------- Build stage ----------
# Runs on the build host's native architecture and cross-compiles to the
# target, so arm64 images build at full speed on any host, with no emulation.
# Chainguard's Go image rather than Docker Hub's golang image; this stage
# never ships, so it only needs a Go toolchain (the image also has bash).
# Chainguard publishes only the `latest` tag for free, so the Go version
# floats; go.mod's `go` line is the minimum it must satisfy.
FROM --platform=$BUILDPLATFORM cgr.dev/chainguard/go:latest AS build
USER 0

# Set automatically by podman build. The fallbacks below cover builders
# that leave them empty, building for the host architecture.
ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

COPY go.mod ./
COPY *.go ./

RUN CGO_ENABLED=0 \
    GOOS=${TARGETOS:-$(go env GOOS)} \
    GOARCH=${TARGETARCH:-$(go env GOARCH)} \
    go build -trimpath -ldflags="-s -w" -o /out/controller .

# ---------- Runtime stage ----------
# Nothing but the statically linked binary: no shell, no libc, no package
# manager, no third-party base image. The controller is CGO-free and its only
# outbound call is plain HTTP to the streamer over pod loopback, so it needs
# neither a CA bundle nor tzdata (log timestamps are UTC without it).
#
# If it ever needs to reach an external HTTPS endpoint, add:
#   COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
FROM scratch

# Links the GHCR package to its source repository.
LABEL org.opencontainers.image.source="https://github.com/danny-berg-whitt/fishcam-webcam-streamer-contoller-broker"
LABEL org.opencontainers.image.description="FishCam controller: HMAC-authenticated mute/status API in front of the streamer"

COPY --from=build /out/controller /usr/local/bin/controller

# nobody:nogroup. Numeric because scratch has no /etc/passwd to resolve names.
USER 65534:65534

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/controller"]
